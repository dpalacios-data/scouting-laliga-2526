	partition hechos_jugador = m
		mode: import
		source =
				let
				    Url = "https://raw.githubusercontent.com/dpalacios-data/scouting-laliga-2526/main/data/modelo/hechos_jugador.csv",
				    Origen = Csv.Document(Web.Contents(Url), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Logicas = {"tiene_eventos", "percentil_fiable", "muestra_reducida"},
				    Enteras = {"id_jugador", "n_grupo_referencia"},
				    Decimales = List.Difference(Table.ColumnNames(Encabezados), List.Combine({Logicas, Enteras})),
				    Tipos = Table.TransformColumnTypes(
				        Encabezados,
				        List.Combine({
				            List.Transform(Logicas, each {_, type logical}),
				            List.Transform(Enteras, each {_, Int64.Type}),
				            List.Transform(Decimales, each {_, type number})
				        }),
				        "en-US"
				    )
				in
				    Tipos

