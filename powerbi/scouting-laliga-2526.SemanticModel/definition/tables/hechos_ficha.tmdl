	partition hechos_ficha = m
		mode: import
		source =
				let
				    Url = "https://raw.githubusercontent.com/dpalacios-data/scouting-laliga-2526/main/data/modelo/hechos_ficha.csv",
				    Origen = Csv.Document(Web.Contents(Url), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {
				        {"id_jugador", Int64.Type}, {"orden", Int64.Type}, {"atributo", type text}, {"valor", type text}
				    }, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

