	partition dim_jugador = m
		mode: import
		source =
				let
				    Url = "https://raw.githubusercontent.com/dpalacios-data/scouting-laliga-2526/main/data/modelo/dim_jugador.csv",
				    Origen = Csv.Document(Web.Contents(Url), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Fechas = {"fecha_nacimiento", "fecha_datos_tm"},
				    Enteras = {"id_jugador","id_equipo","id_posicion","minutos","partidos","edad","altura_cm","valor_mercado_tm","id_understat","id_whoscored","id_transfermarkt"},
				    Textos = List.Difference(Table.ColumnNames(Encabezados), List.Combine({Fechas, Enteras})),
				    Tipos = Table.TransformColumnTypes(
				        Encabezados,
				        List.Combine({
				            List.Transform(Fechas, each {_, type date}),
				            List.Transform(Enteras, each {_, Int64.Type}),
				            List.Transform(Textos, each {_, type text})
				        }),
				        "en-US"
				    )
				in
				    Tipos

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

