	partition dim_equipo = m
		mode: import
		source =
				let
				    Url = "https://raw.githubusercontent.com/dpalacios-data/scouting-laliga-2526/main/data/modelo/dim_equipo.csv",
				    Origen = Csv.Document(Web.Contents(Url), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {
				        {"id_equipo", Int64.Type},
				        {"equipo", type text},
				        {"nombre_equipo", type text},
				        {"altura_defensiva", type number},
				        {"puntos", Int64.Type},
				        {"puntos_esperados", type number},
				        {"escudo", type text},
				        {"url_escudo", type text},
				        {"color_primario", type text},
				        {"color_secundario", type text},
				        {"color_origen", type text},
				        {"color_secundario_origen", type text}
				    }, "en-US")
				in
				    Tipos

